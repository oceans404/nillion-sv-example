{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eth Addresses",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "_id": {
        "type": "string",
        "format": "uuid",
        "coerce": true
      },
      "parties": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "Ethereum address of the party"
        },
        "minItems": 2
      }
    },
    "required": ["_id", "parties"]
  }
}
