{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shelter System",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "_id": {
        "type": "string",
        "format": "uuid",
        "coerce": true
      },
      "shelter_info": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "$share": {
                "type": "string"
              }
            },
            "required": ["$share"]
          },
          "location": {
            "type": "object",
            "properties": {
              "$share": {
                "type": "string"
              }
            },
            "required": ["$share"]
          },
          "operational_costs": {
            "type": "object",
            "properties": {
              "$share": {
                "type": "string"
              }
            },
            "required": ["$share"]
          }
        },
        "required": ["name", "location", "operational_costs"]
      },
      "metrics": {
        "type": "object",
        "properties": {
          "current_animals": {
            "type": "integer",
            "minimum": 0
          },
          "monthly_intake": {
            "type": "integer",
            "minimum": 0
          },
          "neutering_count": {
            "type": "integer",
            "minimum": 0
          },
          "adoption_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "current_animals",
          "monthly_intake",
          "neutering_count",
          "adoption_rate"
        ]
      },
      "animals": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "species": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": ["available", "adopted"]
            },
            "intake_date": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": ["id", "species", "status", "intake_date"]
        }
      }
    },
    "required": ["_id", "shelter_info", "metrics", "animals"]
  }
}
